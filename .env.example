# Copiez ce fichier en .env.local (développement) et renseignez les mêmes
# variables dans Vercel > Settings > Environment Variables (production).

# Adresse publique du site, sans / final (ex. https://jengadigital.com)
NEXT_PUBLIC_SITE_URL=

# Firebase, côté navigateur : Console Firebase > Paramètres du projet > Vos applications > Web
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin, côté serveur uniquement (SECRET) :
# Paramètres du projet > Comptes de service > Générer une nouvelle clé privée.
# Soit le fichier JSON complet sur une ligne :
FIREBASE_SERVICE_ACCOUNT=
# Soit les trois champs séparés :
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Email qui devient super admin à sa première connexion (plusieurs : séparées par des virgules)
BOOTSTRAP_SUPER_ADMIN_EMAIL=

# Adresse qui reçoit les messages du formulaire tant qu'aucune n'est enregistrée
# dans Paramètres du site
CONTACT_EMAIL=

# Resend (SECRET) : https://resend.com/api-keys
RESEND_API_KEY=
# Expéditeur. Avant de vérifier votre domaine dans Resend, gardez onboarding@resend.dev
EMAIL_FROM="JENGA Digital <onboarding@resend.dev>"

# Anti-spam Cloudflare Turnstile (optionnel ; sans clé, seuls le champ piège et la limite par IP s'appliquent)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sel pour anonymiser les adresses IP (SECRET, une chaîne aléatoire)
IP_HASH_SALT=

# Protège les tâches planifiées Vercel (SECRET, une chaîne aléatoire)
CRON_SECRET=
